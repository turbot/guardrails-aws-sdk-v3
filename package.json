{
  "name": "@turbot/guardrails-aws-sdk-v3",
  "author": "Turbot HQ, Inc",
  "description": "Turbot guardrails-aws-sdk-v3 wrapper.",
  "version": "5.0.1",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "coverage": "npx nyc npm test",
    "test": "npx mocha"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "3.978.0",
    "@smithy/node-http-handler": "4.4.8",
    "@smithy/util-retry": "4.2.8",
    "@turbot/errors": "5.3.0",
    "@turbot/log": "5.5.0",
    "aws4": "1.13.2",
    "https-proxy-agent": "7.0.6",
    "lodash": "4.17.23",
    "micromatch": "4.0.8",
    "url": "0.11.4"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "3.978.0",
    "@aws-sdk/client-s3": "3.981.0",
    "@aws-sdk/client-sts": "3.978.0",
    "@aws-sdk/credential-providers": "3.978.0",
    "chai": "4.5.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-you-dont-need-lodash-underscore": "6.14.0",
    "mocha": "11.7.5",
    "nock": "14.0.10",
    "prettier": "3.8.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:prettier/recommended",
      "eslint:recommended",
      "plugin:you-dont-need-lodash-underscore/compatible"
    ],
    "env": {
      "es6": true,
      "node": true,
      "mocha": true
    },
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "rules": {
      "no-console": "off",
      "you-dont-need-lodash-underscore/is-nil": "off"
    }
  },
  "prettier": {
    "printWidth": 120
  }
}
